# Discord Application (Developer Portal -> General Information / OAuth2)
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_PUBLIC_KEY=your_discord_ed25519_public_key
DISCORD_BOT_TOKEN=your_discord_bot_token
# Optional: set for instant guild-scoped slash command registration during testing
DISCORD_GUILD_ID=

# Supabase Project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Vite Client (Exposed to browser inside Discord Activity)
VITE_DISCORD_CLIENT_ID=your_discord_application_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
VITE_EDGE_HOST=w20-discord-vtt.your-subdomain.workers.dev
VITE_R2_ASSETS_HOST=media.your-domain.com
VITE_SUPABASE_HOST=your-project-ref.supabase.co
