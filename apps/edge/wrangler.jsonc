{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "w20-discord-vtt",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "upload_source_maps": true,
  "exports": {
    "GameRoomDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoomDO"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "VTT_MEDIA_BUCKET",
      "bucket_name": "w20-vtt-media"
    }
  ],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/r2-assets/*"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
